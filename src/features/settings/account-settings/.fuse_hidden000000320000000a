/* Account settings — uses existing CSS variables only. */

.settings-page {
  padding: 24px;
  display: flex;
  flex-direction: column;
  gap: 16px;
  max-width: 1100px;
  margin-inline: auto;
  width: 100%;
}

.breadcrumb {
  display: flex;
  align-items: center;
  gap: 8px;
  color: var(--ui-text-muted);
  font-size: 13px;
}
.bc-active { color: var(--ui-text); font-weight: 600; }
.bc-chevron { color: var(--ui-text-muted); }

.page-title {
  margin: 0;
  font-size: 24px;
  font-weight: 700;
  color: var(--ui-text);
}

.settings-shell {
  display: grid;
  grid-template-columns: 220px 1fr;
  gap: 24px;
  align-items: start;
}

/* ── Side nav ─────────────────────────────────────────────────── */
.settings-nav {
  display: flex;
  flex-direction: column;
  gap: 4px;
  background: var(--ui-surface);
  border: 1px solid var(--ui-border);
  border-radius: 10px;
  padding: 8px;
  position: sticky;
  inset-block-start: 16px;
}
.nav-item {
  background: transparent;
  border: none;
  text-align: start;
  padding: 10px 12px;
  border-radius: 8px;
  font-size: 14px;
  color: var(--ui-text);
  cursor: pointer;
}
.nav-item:hover { background: var(--ui-surface-hover, rgba(0,0,0,0.04)); }
.nav-item--active {
  background: var(--ui-surface-hover, rgba(99,102,241,0.1));
  color: var(--brand-primary-500);
  font-weight: 600;
}
.nav-item:focus-visible { outline: 2px solid var(--brand-primary-500); outline-offset: 2px; }

/* ── Section card ─────────────────────────────────────────────── */
.section-card {
  background: var(--ui-surface);
  border: 1px solid var(--ui-border);
  border-radius: 12px;
  padding: 24px;
}
.section-title {
  margin: 0 0 4px;
  font-size: 18px;
  font-weight: 600;
  color: var(--ui-text);
}
.section-sub {
  margin: 0 0 20px;
  font-size: 13px;
  color: var(--ui-text-muted);
}

/* ── Profile read-only grid ───────────────────────────────────── */
.profile-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16px 24px;
  margin: 0 0 16px;
}
.profile-row {
  display: flex;
  flex-direction: column;
  gap: 4px;
}
.profile-row dt {
  font-size: 12px;
  color: var(--ui-text-muted);
  text-transform: uppercase;
  letter-spacing: 0.04em;
}
.profile-row dd {
  margin: 0;
  font-size: 14px;
  color: var(--ui-text);
}
.readonly-note {
  margin: 12px 0 0;
  font-size: 12px;
  color: var(--ui-text-muted);
  font-style: italic;
}

/* ── Form ─────────────────────────────────────────────────────── */
.form {
  display: flex;
  flex-direction: column;
  gap: 16px;
  max-width: 480px;
}
.form-field {
  display: flex;
  flex-direction: column;
  gap: 6px;
}
.form-field label {
  font-size: 13px;
  font-weight: 500;
  color: var(--ui-text);
}
.form-field input {
  padding: 10px 12px;
  border: 1px solid var(--ui-border);
  border-radius: 8px;
  background: var(--ui-surface);
  color: var(--ui-text);
  font-size: 14px;
}
.form-field input:focus-visible {
  outline: 2px solid var(--brand-primary-500);
  outline-offset: 0;
  border-color: var(--brand-primary-500);
}

.form-error {
  color: var(--ui-error, rgb(220,38,38));
  font-size: 12px;
}

.form-message {
  padding: 10px 12px;
  border-radius: 8px;
  font-size: 13px;
}
.form-message--success {
  background: rgba(34,197,94,0.12);
  color: rgb(22,163,74);
  border: 1px solid rgba(34,197,94,0.3);
}
.form-message--error {
  background: rgba(239,68,68,0.12);
  color: rgb(220,38,38);
  border: 1px solid rgba(239,68,68,0.3);
}

.form-actions {
  display: flex;
  gap: 8px;
}
.btn-primary {
  background: var(--brand-primary-500);
  color: #fff;
  border: none;
  border-radius: 8px;
  padding: 10px 18px;
  font-weight: 600;
  font-size: 14px;
  cursor: pointer;
}
.btn-primary:disabled { opacity: 0.5; cursor: not-allowed; }
.btn-primary:focus-visible { outline: 2px solid var(--brand-primary-500); outline-offset: 2px; }

.btn-secondary {
  background: transparent;
  border: 1px solid var(--ui-border);
  color: var(--ui-text);
  border-radius: 8px;
  padding: 8px 14px;
  font-size: 13px;
  cursor: pointer;
}
.btn-secondary:hover { background: var(--ui-surface-hover, rgba(0,0,0,0.04)); }

/* ── State blocks ─────────────────────────────────────────────── */
.state-block {
  padding: 24px;
  text-align: center;
  color: var(--ui-text-muted);
  font-size: 14px;
  background: var(--ui-surface);
  border: 1px dashed var(--ui-border);
  border-radius: 10px;
}
.state-block--error { border-color: rgba(239,68,68,0.3); }
.state-block p { margin: 0 0 12px; }

/* ── Preferences ──────────────────────────────────────────────── */
.pref-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16px;
  padding: 16px 0;
  border-block-end: 1px solid var(--ui-border);
}
.pref-row:last-child { border-block-end: none; }
.pref-label h3 {
  margin: 0;
  font-size: 14px;
  font-weight: 600;
  color: var(--ui-text);
}
.pref-label p {
  margin: 4px 0 0;
  font-size: 12px;
  color: var(--ui-text-muted);
}

.pref-control { display: flex; gap: 4px; }

.seg-btn {
  background: transparent;
  border: 1px solid var(--ui-border);
  color: var(--ui-text);
  padding: 6px 14px;
  font-size: 13px;
  cursor: pointer;
}
.seg-btn:first-child { border-start-start-radius: 6px; border-end-start-radius: 6px; }
.seg-btn:last-child  { border-start-end-radius: 6px;   border-end-end-radius: 6px;   }
.seg-btn--active {
  background: var(--brand-primary-500);
  color: #fff;
  border-color: var(--brand-primary-500);
}
.seg-btn:focus-visible { outline: 2px solid var(--brand-primary-500); outline-offset: 2px; }

.toggle-btn {
  background: transparent;
  border: 1px solid var(--ui-border);
  color: var(--ui-text);
  border-radius: 999px;
  padding: 6px 16px;
  font-size: 13px;
  cursor: pointer;
}
.toggle-btn:focus-visible { outline: 2px solid var(--brand-primary-500); outline-offset: 2px; }

/* ── Mobile ───────────────────────────────────────────────────── */
@media (max-width: 768px) {
  .settings-shell { grid-template-columns: 1fr; }
  .settings-nav { position: static; flex-direction: row; overflow-x: auto; }
  .nav-item { white-space: nowrap; }
  .profile-grid { grid-template-columns: 1fr; }
  .pref-row { flex-direction: column; align-items: flex-start; }
}
