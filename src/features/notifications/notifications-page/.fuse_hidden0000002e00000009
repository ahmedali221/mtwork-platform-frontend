/* Notifications page — uses existing CSS variables only. */

.notifications-page {
  padding: 24px;
  display: flex;
  flex-direction: column;
  gap: 16px;
  max-width: 800px;
  margin-inline: auto;
  width: 100%;
}

.breadcrumb {
  display: flex;
  align-items: center;
  gap: 8px;
  color: var(--ui-text-muted);
  font-size: 13px;
}
.bc-active { color: var(--ui-text); font-weight: 600; }
.bc-chevron { color: var(--ui-text-muted); }

.page-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}
.page-title-wrap {
  display: flex;
  align-items: center;
  gap: 12px;
}
.page-title {
  margin: 0;
  font-size: 24px;
  font-weight: 700;
  color: var(--ui-text);
}
.count-badge {
  background: var(--brand-primary-500);
  color: #fff;
  border-radius: 999px;
  padding: 2px 10px;
  font-size: 12px;
  font-weight: 600;
}

.btn-mark-all {
  background: transparent;
  border: 1px solid var(--ui-border);
  color: var(--ui-text);
  border-radius: 8px;
  padding: 8px 14px;
  font-size: 13px;
  font-weight: 500;
  cursor: pointer;
}
.btn-mark-all:hover:not(:disabled) {
  background: var(--ui-surface-hover, rgba(0,0,0,0.04));
}
.btn-mark-all:focus-visible { outline: 2px solid var(--brand-primary-500); outline-offset: 2px; }
.btn-mark-all:disabled { opacity: 0.5; cursor: not-allowed; }

/* ── Filter tabs ──────────────────────────────────────────────── */
.filter-tabs {
  display: flex;
  gap: 4px;
  border-block-end: 1px solid var(--ui-border);
}
.filter-tab {
  background: transparent;
  border: none;
  padding: 10px 16px;
  font-size: 14px;
  font-weight: 500;
  color: var(--ui-text-muted);
  cursor: pointer;
  border-block-end: 2px solid transparent;
  display: inline-flex;
  align-items: center;
  gap: 8px;
}
.filter-tab:hover { color: var(--ui-text); }
.filter-tab--active {
  color: var(--brand-primary-500);
  border-block-end-color: var(--brand-primary-500);
}
.filter-tab:focus-visible { outline: 2px solid var(--brand-primary-500); outline-offset: 2px; }

.tab-count {
  background: var(--brand-primary-500);
  color: #fff;
  border-radius: 999px;
  font-size: 11px;
  padding: 1px 7px;
  font-weight: 600;
}

/* ── List ─────────────────────────────────────────────────────── */
.notif-list {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.notif-item {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  padding: 14px 16px;
  background: var(--ui-surface);
  border: 1px solid var(--ui-border);
  border-radius: 10px;
  cursor: pointer;
  position: relative;
  transition: background-color 120ms ease;
}
.notif-item:hover { background: var(--ui-surface-hover, rgba(0,0,0,0.03)); }
.notif-item:focus-visible { outline: 2px solid var(--brand-primary-500); outline-offset: 2px; }
.notif-item--unread { border-color: var(--brand-primary-500); }

.notif-icon {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  display: grid;
  place-items: center;
  flex: none;
  background: var(--ui-surface-hover, rgba(0,0,0,0.05));
  color: var(--ui-text-muted);
}
.notif-icon--info    { background: rgba(59,130,246,0.12);  color: rgb(37,99,235);  }
.notif-icon--success { background: rgba(34,197,94,0.12);   color: rgb(22,163,74);  }
.notif-icon--warning { background: rgba(234,179,8,0.14);   color: rgb(202,138,4);  }
.notif-icon--error   { background: rgba(239,68,68,0.12);   color: rgb(220,38,38);  }

.notif-body { flex: 1; min-width: 0; }
.notif-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 8px;
}
.notif-title {
  margin: 0;
  font-size: 14px;
  font-weight: 600;
  color: var(--ui-text);
}
.notif-time { font-size: 12px; color: var(--ui-text-muted); flex: none; }
.notif-msg {
  margin: 4px 0 0;
  font-size: 13px;
  color: var(--ui-text-muted);
  line-height: 1.4;
}

.notif-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--brand-primary-500);
  flex: none;
  margin-block-start: 6px;
}

.notif-empty {
  padding: 48px 16px;
  text-align: center;
  color: var(--ui-text-muted);
  font-size: 14px;
  background: var(--ui-surface);
  border: 1px dashed var(--ui-border);
  border-radius: 10px;
}
.notif-empty p { margin: 0; }
